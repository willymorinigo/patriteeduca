rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'grade', 'level', 'targetSubjects', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.grade is string && data.grade.size() <= 100
        && data.level is string && data.level.size() <= 100
        && data.targetSubjects is list && data.targetSubjects.size() <= 10
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['id', 'studentId', 'subject', 'topicTitle', 'date', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.studentId is string && data.studentId.size() <= 128
        && data.subject is string && data.subject.size() <= 100
        && data.topicTitle is string && data.topicTitle.size() <= 250
        && data.date is string && data.date.size() <= 50
        && data.status is string && data.status.size() <= 50;
    }

    function isValidWorksheet(data) {
      return data.keys().hasAll(['id', 'title', 'subject', 'level', 'topic', 'difficulty', 'date', 'pedagogicalIntro', 'exercises'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 250
        && data.subject is string && data.subject.size() <= 100
        && data.topic is string && data.topic.size() <= 250
        && data.exercises is list && data.exercises.size() <= 30;
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId) && isValidStudent(request.resource.data);
      allow delete: if isValidId(studentId);
    }

    // Records Collection
    match /records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    // Worksheets Collection
    match /worksheets/{worksheetId} {
      allow read: if true;
      allow create, update: if isValidId(worksheetId) && isValidWorksheet(request.resource.data);
      allow delete: if isValidId(worksheetId);
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
